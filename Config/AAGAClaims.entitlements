<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mobile SDK keeps OAuth tokens and encryption keys in the keychain. Without an access
	     group the simulator refuses keychain writes (errSecMissingEntitlement, -34018). -->
	<!-- Push notifications (spec §8). Xcode sets "production" in App Store and TestFlight builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links (spec §8): app.accurateadjustmentsga.com serves the apple-app-site-association
	     file from Tools/universal-links. Salesforce serves its own on the portal domain. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.accurateadjustmentsga.com</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.accurateadjustmentsga.claims</string>
	</array>
</dict>
</plist>
